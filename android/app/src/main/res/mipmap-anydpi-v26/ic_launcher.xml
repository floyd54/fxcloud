<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon (device pass: "boring" -> a cloud with fx):
     minSdk26 means the adaptive layer pair covers every device, no
     PNG densities needed. The background is the window's dark with a
     touch of depth, the foreground the soft blue cloud and the fx in
     the web's accent family. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
