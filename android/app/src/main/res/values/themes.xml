<?xml version="1.0" encoding="utf-8"?>
<!-- The proven S1 window: Material.Light with an action bar + an
     inflated layout was the combination that rendered on the first
     real device (the two prior builds, NoActionBar + programmatic
     view, showed a blank screen - the exact culprit between those two
     changes was never isolated, so this stays the shape that works).
     The window background matches the content panel so nothing flashes
     green-ish or white before the first frame. -->
<resources>
    <style name="Theme.Fxcloud" parent="@android:style/Theme.Material.Light">
        <item name="android:windowBackground">#14161B</item>
    </style>
</resources>
