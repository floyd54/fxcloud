<?xml version="1.0" encoding="utf-8"?>
<!-- Foreground of the launcher mark (device pass feedback): the light
     blue field lives in the background layer; here the brand cloud -
     the same three puffs gen-icons.js draws at CLOUD_SCALE1.25 (a
     round launcher mask needs the margin), solid #0082c9, with a
     second cloud in #00598F offset down-left behind it (light from
     the upper right, the back cloud reading as the shadow), and a
     white fx at FX_SCALE0.71 so the letters keep their room as the
     cloud shrinks. All circles wind the same way in one path, so the
     union stays solid under nonZero. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- the shadow cloud: same puffs, offset down-left -->
    <group android:translateX="-4.5" android:translateY="5.5">
        <path
            android:fillColor="#00598F"
            android:fillType="nonZero"
            android:pathData="M24.3,60.2 a12.2,12.2 0,0,1,24.4,0 a12.2,12.2 0,0,1,-24.4,0 z M36.4,49.4 a17.6,17.6 0,0,1,35.2,0 a17.6,17.6 0,0,1,-35.2,0 z M59.4,60.2 a12.2,12.2 0,0,1,24.4,0 a12.2,12.2 0,0,1,-24.4,0 z" />
    </group>

    <!-- the cloud: left puff, top puff, right puff -->
    <path
        android:fillColor="#0082C9"
        android:fillType="nonZero"
        android:pathData="M24.3,60.2 a12.2,12.2 0,0,1,24.4,0 a12.2,12.2 0,0,1,-24.4,0 z M36.4,49.4 a17.6,17.6 0,0,1,35.2,0 a17.6,17.6 0,0,1,-35.2,0 z M59.4,60.2 a12.2,12.2 0,0,1,24.4,0 a12.2,12.2 0,0,1,-24.4,0 z" />

    <!-- f: hook and stem, then the crossbar -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M51.3,46 C51.3,43.3 48.7,42.4 46.9,45.1 L46.9,62.9" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M42.4,52.2 L51.3,52.2" />

    <!-- x -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M55.9,45.1 L65.6,62.9 M65.6,45.1 L55.9,62.9" />
</vector>
