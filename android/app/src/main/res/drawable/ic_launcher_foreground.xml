<?xml version="1.0" encoding="utf-8"?>
<!-- Foreground of the launcher mark (device pass feedback): the light
     blue field lives in the background layer; here the brand cloud -
     the same three puffs gen-icons.js draws, solid #0082c9 with the
     drop shadow below (three alpha steps, the vector's answer to the
     generator's soft edge), and a white fx with room to breathe. All
     circles wind the same way in one path, so the union stays solid
     under nonZero. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- drop shadow: the cloud shifted down, lighter with each step -->
    <group android:translateY="4.8">
        <path
            android:fillColor="#121B3A54"
            android:fillType="nonZero"
            android:pathData="M20.7,60.7 a13.6,13.6 0,0,1,27.2,0 a13.6,13.6 0,0,1,-27.2,0 z M34.3,48.6 a19.7,19.7 0,0,1,39.4,0 a19.7,19.7 0,0,1,-39.4,0 z M60.1,60.7 a13.6,13.6 0,0,1,27.2,0 a13.6,13.6 0,0,1,-27.2,0 z" />
    </group>
    <group android:translateY="3.2">
        <path
            android:fillColor="#241B3A54"
            android:fillType="nonZero"
            android:pathData="M20.7,60.7 a13.6,13.6 0,0,1,27.2,0 a13.6,13.6 0,0,1,-27.2,0 z M34.3,48.6 a19.7,19.7 0,0,1,39.4,0 a19.7,19.7 0,0,1,-39.4,0 z M60.1,60.7 a13.6,13.6 0,0,1,27.2,0 a13.6,13.6 0,0,1,-27.2,0 z" />
    </group>
    <group android:translateY="1.6">
        <path
            android:fillColor="#381B3A54"
            android:fillType="nonZero"
            android:pathData="M20.7,60.7 a13.6,13.6 0,0,1,27.2,0 a13.6,13.6 0,0,1,-27.2,0 z M34.3,48.6 a19.7,19.7 0,0,1,39.4,0 a19.7,19.7 0,0,1,-39.4,0 z M60.1,60.7 a13.6,13.6 0,0,1,27.2,0 a13.6,13.6 0,0,1,-27.2,0 z" />
    </group>

    <!-- the cloud: left puff, top puff, right puff -->
    <path
        android:fillColor="#0082C9"
        android:fillType="nonZero"
        android:pathData="M20.7,60.7 a13.6,13.6 0,0,1,27.2,0 a13.6,13.6 0,0,1,-27.2,0 z M34.3,48.6 a19.7,19.7 0,0,1,39.4,0 a19.7,19.7 0,0,1,-39.4,0 z M60.1,60.7 a13.6,13.6 0,0,1,27.2,0 a13.6,13.6 0,0,1,-27.2,0 z" />

    <!-- f: hook and stem, then the crossbar -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M51,45 C51,42 48,41 46,44 L46,64" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M41,52 L51,52" />

    <!-- x -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M55,44 L67,64 M67,44 L55,64" />
</vector>
