[Unit]
Description=fxcloud – personal cloud (single-binary Nextcloud alternative)
After=network.target

[Service]
Type=simple
User=fxcloud
Group=fxcloud
WorkingDirectory=/home/fxcloud
ExecStart=/home/fxcloud/fxcloud
Restart=on-failure
RestartSec=3

# --- Environment configuration ---------------------------------------------
Environment=FXCLOUD_BIND=0.0.0.0
Environment=FXCLOUD_PORT=8080
Environment=FXCLOUD_DATA=/home/fxcloud/data
Environment=RUST_LOG=fxcloud=info
# Enable when serving over HTTPS behind a TLS-terminating reverse proxy:
# Environment=FXCLOUD_SECURE_COOKIE=1
# The exact URL users open fxcloud under - required for passkeys when a
# reverse proxy rewrites Host or terminates TLS (e.g. https://cloud.example.com):
# Environment=FXCLOUD_ORIGIN=https://cloud.example.com

# --- Security hardening ----------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# The binary and the data partition both live in the service user's own home,
# so hiding /home would break the unit; the home directory is 750 and owned by
# fxcloud:fxcloud, which is the actual access control here.
ProtectHome=false
ReadWritePaths=/home/fxcloud/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
